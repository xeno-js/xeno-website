---
// website/src/pages/index.astro
// Qui puoi importare liberamente i tuoi componenti personalizzati
// import MyComponent from '../components/MyComponent.astro';
---

<!DOCTYPE html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Xeno Framework - Official Documentation</title>
  </head>
  <body class="bg-slate-950 text-white min-h-screen flex flex-col items-center justify-center">
    
    <main class="text-center p-6 max-w-3xl">
      <h1 class="text-6xl font-extrabold tracking-tight bg-gradient-to-r from-blue-500 via-indigo-500 to-purple-500 bg-clip-text text-transparent">
        Xeno Framework
      </h1>
      <p class="mt-6 text-xl text-slate-400 max-w-xl mx-auto">
        Un framework architetturale type-safe basato su Domain-Driven Design (DDD) e CQRS per ambienti Node.js.
      </p>
      
      <div class="mt-10 flex gap-4 justify-center">
        <a href="/getting-started" class="px-6 py-3.5 bg-indigo-600 hover:bg-indigo-700 font-semibold rounded-xl transition shadow-lg shadow-indigo-600/20">
          Inizia Ora
        </a>
        <a href="https://github.com/tuo-profilo/xeno" class="px-6 py-3.5 bg-slate-800 hover:bg-slate-700 font-semibold rounded-xl transition border border-slate-700">
          GitHub
        </a>
      </div>
    </main>

  </body>
</html>