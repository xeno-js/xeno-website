---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/homepage/Hero.astro';
import Divider from '../components/homepage/Divider.astro';
import Features from '../components/homepage/Features.astro';
import CodeShowCase from '../components/homepage/CodeShowCase.astro';
import DemoCTA from '../components/homepage/DemoCTA.astro';
import SupportSection from '../components/homepage/SupportSection.astro';

// Current page path for active state handling
const currentPath = Astro.url.pathname;
---

<Layout 
  title="Xeno Framework - Enterprise-grade DDD & CQRS framework for Node.js" 
  description="An architectural type-safe framework built on Domain-Driven Design (DDD) and CQRS for scalable and maintainable Node.js applications."
  canonicalURL={Astro.url.href}
>
  <Hero />
  <Divider />
  <Features />
  <CodeShowCase />
  <DemoCTA />
  <SupportSection />

</Layout>