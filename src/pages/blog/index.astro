---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout 
  title="Xeno.JS - Technical Blog & Architectures" 
  description="In-depth technical insights into Domain-Driven Design, CQRS, Clean Architecture, and scalable backend development in TypeScript with Xeno.JS."
>
  <section class="max-w-4xl mx-auto px-6 py-16">
    <!-- Header della sezione -->
    <div class="mb-12 border-b border-[var(--border-color)] pb-8">
      <h1 class="text-4xl font-extrabold tracking-tight mb-3">Xeno<span class="text-[var(--color-primary)]">.JS</span> Blog</h1>
      <p class="text-[var(--text-muted)] text-lg">
        Behind the scenes: architectural choices and practical guides for scaling backend systems in TypeScript.
      </p>
    </div>

    <!-- Lista degli articoli -->
    <div class="grid gap-6">
      {posts.map((post, index) => {
        // Tronca la descrizione a circa 150 caratteri aggiungendo i puntini di sospensione
        const truncatedDesc = post.data.description.length > 150 
          ? `${post.data.description.substring(0, 150)}...` 
          : post.data.description;
        const tags = post.data.keywords
          ? post.data.keywords.split(',').map((k) => k.trim()).filter(Boolean).slice(0, 3)
          : [];

        return (
          <article
            class="reveal card-interactive p-6 rounded-[var(--border-radius)] bg-[var(--bg-secondary)] border border-[var(--border-color)] group"
            style={`--i: ${index}`}
          >
            <div class="flex items-center gap-3 text-xs text-[var(--text-muted)] mb-3">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('it-IT', { 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric' 
                })}
              </time>
              <span>•</span>
              <span>{post.data.author}</span>
            </div>

            <a href={`/blog/${post.id}`} class="block outline-none">
              <h2 class="text-2xl font-bold group-hover:text-[var(--color-primary)] transition-colors mb-2">
                {post.data.title}
              </h2>
            </a>

            <p class="text-[var(--text-muted)] text-sm leading-relaxed mb-4">
              {truncatedDesc}
            </p>

            {tags.length > 0 && (
              <ul class="flex flex-wrap gap-2 mb-4" aria-label="Tag">
                {tags.map((tag) => <li class="chip">{tag}</li>)}
              </ul>
            )}

            <a
              href={`/blog/${post.id}`}
              class="link-sweep inline-flex items-center text-sm font-semibold text-[var(--color-primary)] gap-1"
            >
              Read more <i class="bi bi-arrow-right arrow-nudge" aria-hidden="true"></i>
            </a>
          </article>
        );
      })}
    </div>
  </section>
</Layout>