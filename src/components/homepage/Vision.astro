---
const statement = [
  ['Business', 0], ['logic', 0], ['stays', 0], ['in', 0], ['the', 0], ['application', 1], ['layer.', 1],
  ['HTTP,', 0], ['databases', 0], ['and', 0], ['tooling', 0], ['stay', 0], ['at', 0], ['the', 0], ['edge.', 1],
  ['Your', 0], ['handlers', 0], ['describe', 0], ['use', 1], ['cases,', 1], ['not', 0], ['routes.', 0],
] as const;
---
<!-- Scroll-driven text highlight -->
<section class="px-6 py-24 sm:py-36">
  <div class="mx-auto max-w-5xl">
    <p class="hx-eyebrow mb-6">01 / Principle</p>
    <p data-highlight class="text-3xl font-bold leading-[1.25] tracking-tight sm:text-5xl">
      {statement.map(([word, accent]) => (
        <><span class="hx-hl-word" data-accent={accent ? 'true' : 'false'}>{word}</span>{' '}</>
      ))}
    </p>
  </div>
</section>
