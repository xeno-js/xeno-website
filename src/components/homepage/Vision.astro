---
const nodes = [
  { icon: "bi-cpu", pkg: "@xeno-js/core", role: "Backend" },
  { icon: "bi-browser-edge", pkg: "@xeno-js/vue", role: "Frontend" },
];
---

<section class="py-24 px-6 overflow-hidden">
  <div class="max-w-[var(--container-max)] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-14 items-center">
    <div data-reveal class="lg:col-span-6">
      <span class="eyebrow mb-5"><i class="bi bi-diagram-3-fill"></i> Backend and frontend</span>
      <h2 class="section-title !mt-5">
        Use application patterns in <span class="text-[var(--color-primary)]">Vue</span>.
      </h2>
      <p class="section-lead mb-4">
        With @xeno-js/vue, you can use commands, queries, pipelines, context and explicit application composition in a Vue application.
      </p>
      <p class="section-lead">
        Share architectural concepts between Node.js and Vue while keeping domain logic separate from transport, database and UI concerns.
      </p>
    </div>

    <div class="lg:col-span-6 perspective" data-reveal data-reveal-delay="0.15">
      <div data-tilt="5" data-base-x="6" data-base-y="-8" class="preserve-3d relative flex flex-col sm:flex-row items-center justify-center gap-6">
        <div class="hidden sm:block absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-40 h-px bg-gradient-to-r from-transparent via-[var(--color-primary)] to-transparent" aria-hidden="true"></div>
        {nodes.map((n, i) => (
          <div class="preserve-3d w-full sm:w-56" style={`transform: translateZ(${i ? 40 : 0}px)`}>
            <div data-float class="glass spotlight p-6 flex flex-col items-center text-center">
              <span class="icon-chip !w-14 !h-14 !text-2xl mb-4"><i class={`bi ${n.icon}`}></i></span>
              <span class="font-[family-name:var(--font-mono)] text-sm font-bold text-[var(--text-code)]">{n.pkg}</span>
              <span class="text-xs font-medium uppercase tracking-wider text-[var(--text-muted)] mt-1">{n.role}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
