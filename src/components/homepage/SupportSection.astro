---
import Button from '../ui/Button.astro';
---

<section class="py-24 px-6 relative overflow-hidden">
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[560px] h-[560px] rounded-full bg-[var(--color-primary)] opacity-[0.1] blur-[140px] pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 max-w-[var(--container-max)] mx-auto perspective" data-reveal>
    <div data-tilt="2" class="glass spotlight p-8 sm:p-12 lg:p-16 text-center flex flex-col items-center">
      <span class="eyebrow mb-6"><i class="bi bi-heart-fill"></i> Support open source</span>
      <h2 class="section-title max-w-3xl !mt-0">
        Help keep <span class="text-[var(--color-primary)]">Xeno</span> independent and sustainable.
      </h2>
      <p class="section-lead max-w-2xl mb-10">
        Xeno.JS is an independent, MIT-licensed open-source project. Your support helps maintain the core, documentation, tooling and packages.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="https://www.buymeacoffee.com/xenojs" variant="primary" class="w-full sm:w-auto px-8 py-3.5" target="_blank">
          <i class="bi bi-cup-hot-fill"></i> Buy Me A Coffee
        </Button>
        <Button href="/contributing-guide" variant="secondary" class="w-full sm:w-auto px-8 py-3.5" target="_blank">
          <i class="bi bi-star-fill text-[var(--color-primary)]"></i> Contributing
        </Button>
      </div>

      <p class="text-xs font-mono text-[var(--text-muted)] !mt-8 !mb-0">
        Using Xeno.JS in production? Reach out at <a href="mailto:xeno-js@outlook.it" class="text-[var(--color-primary)] hover:underline">xeno-js@outlook.it</a>.
      </p>
    </div>
  </div>
</section>
