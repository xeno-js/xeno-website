---
import Button from '../ui/Button.astro';
---

<!-- Open source and final call to action -->
<section class="px-6 pb-24 pt-10 sm:pb-32">
  <div data-reveal class="hx-glass relative mx-auto max-w-[var(--container-max)] overflow-hidden px-7 py-14 text-center sm:px-12 sm:py-20">
    <div class="relative">
      <p class="hx-eyebrow mb-4">06 / Built in the open</p>
      <h2 class="hx-title mx-auto max-w-3xl">A clear foundation for your next product.</h2>
      <p class="hx-lead mx-auto mt-5 max-w-xl">Xeno.JS is MIT-licensed. Explicit contracts and separate domain logic help you understand how the application fits together, from a first API to a growing team.</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <Button href="/docs/getting_started/installation" variant="primary" class="min-h-12 px-8">Open the installation guide <i class="bi bi-arrow-up-right" aria-hidden="true"></i></Button>
        <Button href="https://github.com/xeno-js/core" variant="secondary" class="min-h-12 px-6">Explore GitHub</Button>
      </div>
      <div class="mt-4 flex flex-wrap justify-center gap-5 text-sm font-semibold"><a href="/contributing-guide" class="hx-link">Contribute</a><a href="/support-us" class="hx-link">Support the project</a></div>
    </div>
  </div>
</section>
