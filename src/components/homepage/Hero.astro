---
import Button from '../ui/Button.astro';

const layers = [
  { number: '04', name: 'Interface', detail: '@xeno-js/vue', icon: 'bi-window' },
  { number: '03', name: 'Transport', detail: '@xeno-js/node, @xeno-js/fastify, @xeno-js/vercel', icon: 'bi-hdd-network' },
  { number: '02', name: 'Application', detail: '@xeno-js/core (Commands, queries, pipelines)', icon: 'bi-boxes' },
  { number: '01', name: 'Domain', detail: '@xeno-js/shared (Business rules, value objects)', icon: 'bi-diamond' },
];

const title = [
  { text: 'Structure', accent: false },
  { text: 'your', accent: false },
  { text: 'TypeScript', accent: true },
  { text: 'backend', accent: true },
  { text: 'around', accent: false },
  { text: 'business', accent: false },
  { text: 'logic.', accent: false },
];
---

<section class="relative px-6 pb-16 pt-16 sm:pb-24 sm:pt-24" data-hero>
  <div class="relative mx-auto grid max-w-[var(--container-max)] items-center gap-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
    <div>
      <span data-hero-in class="hx-glass mb-7 inline-flex items-center gap-2 !rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
        <span class="h-2 w-2 rounded-full bg-[var(--color-primary)] shadow-[0_0_12px_var(--color-primary)]"></span> Open source, MIT licensed
      </span>
      <h1 class="max-w-3xl text-5xl font-extrabold leading-[1.06] tracking-[-0.045em] sm:text-6xl xl:text-7xl" aria-label="Structure your TypeScript backend around business logic.">
        {title.map((word) => (
          <>
            <span data-hero-word aria-hidden="true" class:list={['hx-word', word.accent && 'text-[var(--color-primary)]']}>{word.text}</span>{' '}
          </>
        ))}
      </h1>
      <p data-hero-in class="mt-7 max-w-xl text-lg leading-relaxed text-[var(--text-muted)] sm:text-xl">
        Xeno.JS is an open-source Node.js framework for growing applications. Keep business logic clear with explicit dependency injection, CQRS and pipelines.
      </p>
      <p data-hero-in class="mt-4 max-w-xl text-base text-[var(--text-muted)]">
        Build with Node.js or Fastify, deploy on Vercel, or run scoped application work without an HTTP server.
      </p>
      <div data-hero-in class="mt-9 flex flex-wrap gap-3">
        <Button href="/docs/getting_started/installation" variant="primary" class="min-h-12 px-6">Install Xeno.JS <i class="bi bi-arrow-up-right" aria-hidden="true"></i></Button>
        <Button href="#code" variant="secondary" class="min-h-12 px-6">See the code <i class="bi bi-arrow-down" aria-hidden="true"></i></Button>
      </div>
    </div>

    <div data-hero-in data-hero-stage class="relative px-2 py-8 [perspective:1400px] sm:px-8" role="group" aria-label="Xeno.JS application layers">
      <div aria-hidden="true" class="absolute inset-8 rounded-[2rem] opacity-30 [transform:rotate(-5deg)]"></div>
      <div aria-hidden="true" class="absolute inset-8 rounded-[2rem] [transform:rotate(4deg)]"></div>
      <div data-hero-card class="hx-3d hx-stack p-5 sm:p-7" style="transition: transform 0.2s ease-out; will-change: transform;">
        <div class="mb-6 flex items-center justify-between border-b border-[var(--glass-border)] pb-4 font-[family-name:var(--font-mono)] text-xs text-[var(--text-muted)]">
          <span>application.layers</span><span>4 layers</span>
        </div>
        <ol class="m-0 list-none space-y-3 p-0 [transform-style:preserve-3d]">
          {layers.map((layer, index) => (
            <li
              data-layer-z={(4 - index) * 14}
              class:list={['hx-layer flex items-center gap-4 rounded-2xl border p-4', layer.name === 'Application' ? 'border-[var(--color-primary)] bg-[var(--accent-glow)] shadow-[0_8px_28px_-12px_var(--color-primary)]' : 'border-[var(--glass-border)] bg-[var(--bg-primary)]/60']}
            >
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[var(--glass-border)] text-[var(--color-primary)]"><i class={`bi ${layer.icon}`} aria-hidden="true"></i></span>
              <span class="min-w-0 flex-1"><span class="block font-semibold text-[var(--text-main)]">{layer.name}</span><span class="block text-xs text-[var(--text-muted)]">{layer.detail}</span></span>
              <span class="font-[family-name:var(--font-mono)] text-xs text-[var(--text-muted)]">{layer.number}</span>
            </li>
          ))}
        </ol>
        <p class="mb-0 mt-5 text-xs text-[var(--text-muted)]">Choose the integrations your application needs.</p>
      </div>
    </div>
  </div>
</section>
