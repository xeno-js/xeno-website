---
import Button from '../ui/Button.astro'
---

{/* Hero Section (NestJS Modern Style with Glassmorphism & Primary Green Glow) */}
<section
  class="relative min-h-[90vh] flex items-center justify-center overflow-hidden pt-24 pb-16 px-6"
>
  {/* Background Mirror / Glass Glow Effect using Brand Primary Color */}
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] sm:w-[600px] h-[350px] sm:h-[600px] bg-[var(--color-primary)] opacity-10 blur-[120px] sm:blur-[140px] rounded-full pointer-events-none -z-10"
  >
  </div>
  <div
    class="absolute top-1/4 left-1/4 w-[200px] h-[200px] bg-[var(--color-primary)] opacity-5 blur-[90px] rounded-full pointer-events-none -z-10"
  >
  </div>

  <div
    class="w-full max-w-[var(--container-max)] mx-auto text-center relative z-10 flex flex-col items-center"
  >
    {/* Glassmorphism Announcement Badge */}
    <div data-aos="fade-right" data-aos-delay="100" class="md:col-span-5 text-left">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-xs font-semibold mb-4 tracking-wider uppercase border border-[var(--color-primary)]/20"
      >
      <i class="bi bi-lightning-fill"></i>
          Next-Gen Architecture for Node.js
      </div>
    </div>

    {/* Main Title */}
    <h1
      data-aos="fade-up"
      data-aos-delay="120"
      class="text-3xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-[var(--text-main)] max-w-5xl mx-auto leading-[1.1] mb-6"
    >
      Enterprise-grade <span
        class="text-transparent bg-clip-text bg-gradient-to-r from-[var(--color-primary)] to-[#ffffff]"
        >DDD & CQRS</span
      > framework for Node.js
    </h1>

    {/* Payoff description featuring Xeno */}
    <p
      data-aos="fade-up"
      data-aos-delay="220"
      class="text-base sm:text-xl text-[var(--text-muted)] max-w-3xl mx-auto font-normal leading-relaxed mb-10"
    >
      Discover <strong class="text-[var(--text-main)] font-semibold">Xeno</strong>, a type-safe
      architectural framework designed to eliminate runtime magic, providing explicit Inversion of
      Control, absolute domain isolation, and deterministic execution pipelines.
    </p>

    {/* Action Buttons (Docs Index & Source Code) */}
    <div
      data-aos="fade-up"
      data-aos-delay="320"
      class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto"
    >
      <Button
        href="/introduction"
        variant="primary"
        class="w-full sm:w-auto px-8 py-4 text-base shadow-[0_0_30px_var(--accent-glow)]"
      >
        Getting Started
      </Button>
      <Button
        href="https://github.com/Mattia-Carcione/xeno-js"
        variant="secondary"
        class="w-full sm:w-auto px-8 py-4 text-base"
      >
        <i class="bi bi-github text-lg mr-2"></i> Source Code
      </Button>
    </div>

    {/* Glassmorphism Terminal Preview Box (Mirror Effect Style) */}
    <div
      data-aos="zoom-in"
      data-aos-delay="420"
      class="mt-16 w-full max-w-3xl rounded-[var(--border-radius)] bg-[var(--bg-secondary)]/50 border border-[var(--border-color)] backdrop-blur-2xl p-5 sm:p-6 text-left shadow-2xl relative overflow-hidden group"
    >
      <div
        class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-[var(--color-primary)] to-transparent opacity-60"
      >
      </div>
      <div
        class="flex items-center justify-between mb-4 pb-3 border-b border-[var(--border-color)]"
      >
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
        </div>
        <span class="text-xs font-mono text-[var(--text-muted)]">terminal — xeno-cli</span>
      </div>
      <pre
        class="font-[family-name:var(--font-mono)] text-xs sm:text-sm text-[var(--text-main)] overflow-x-auto"><code class="language-bash"><span class="text-[var(--color-primary)]">$</span> npm install @xeno/cli
<span class="text-[var(--color-primary)]">$</span> xeno my-xeno-app
<span class="text-emerald-400">✔ Scaffolding completed successfully!</span></code></pre>
    </div>
  </div>
</section>
