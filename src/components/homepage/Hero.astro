---
import Button from "../ui/Button.astro";

const layers = [
  {
    icon: "bi-browser-edge",
    label: "UI",
    pkg: "@xeno-js/vue",
    detail: "Vue components · Composables",
    z: 100,
    accent: false,
  },
  {
    icon: "bi-window-stack",
    label: "Transport",
    pkg: "@xeno-js/fastify · @xeno-js/node · @xeno-js/vercel",
    detail: "Fastify · Node · Vercel",
    z: 75,
    accent: false,
  },
  {
    icon: "bi-diagram-3",
    label: "Application",
    pkg: "@xeno-js/core",
    detail: "Commands · Queries · Pipelines · Context",
    z: 45,
    accent: true,
  },
  {
    icon: "bi-gem",
    label: "Domain",
    pkg: "@xeno-js/shared",
    detail: "Aggregates · Value Objects · Result",
    z: 0,
    accent: false,
  },
];

const stack = ["TypeScript", "Node.js", "DDD", "CQRS", "Explicit DI"];
---

<section class="relative overflow-hidden pt-16 pb-24 lg:pt-24 lg:pb-32 px-6 md:h-screen">
  <div class="absolute inset-0 bg-grid pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[720px] h-[720px] rounded-full bg-[var(--color-primary)] opacity-[0.12] blur-[140px] pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 max-w-[var(--container-max)] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
    <div class="lg:col-span-6">
      <div data-reveal data-reveal-delay="0.05" class="mb-6">
        <span class="eyebrow"><i class="bi bi-box-seam"></i> Application architecture framework</span>
      </div>

      <h1 data-reveal data-reveal-delay="0.12" class="text-4xl sm:text-5xl lg:text-6xl !leading-[1.05] !tracking-[-0.035em] !mb-6">
        TypeScript <span class="text-[var(--color-primary)]">application architecture</span> for Node.js
      </h1>

      <p data-reveal data-reveal-delay="0.2" class="text-lg sm:text-xl !text-[var(--text-muted)] max-w-xl !mb-4">
        <strong>Xeno.JS is an application architecture framework for TypeScript.</strong> It helps you organize backend use cases, dependencies and domain logic.
      </p>
      <p data-reveal data-reveal-delay="0.26" class="!text-[var(--text-muted)] max-w-xl !mb-10">
  Use explicit dependency injection, CQRS, request context and pipelines with Xeno.JS's own HTTP server and plugins, while keeping HTTP separate from the application layer.
</p>

      <div data-reveal data-reveal-delay="0.32" class="flex flex-col sm:flex-row gap-4 mb-10">
        <Button href="/docs/getting_started/installation" variant="primary" class="px-8 py-3.5">
          Install Xeno.JS <i class="bi bi-arrow-right"></i>
        </Button>
        <Button href="#packages" variant="secondary" class="px-8 py-3.5">
          Explore packages
        </Button>
      </div>

      <ul data-reveal data-reveal-delay="0.4" class="flex flex-wrap gap-2 list-none p-0 m-0" aria-label="Built on">
        {stack.map((s) => (
          <li class="px-3 py-1 rounded-full text-xs font-medium text-[var(--text-muted)] border border-[var(--glass-border)] bg-[var(--glass-bg)]">{s}</li>
        ))}
      </ul>
    </div>

    {/* 3D layered architecture stage */}
    <div class="lg:col-span-6 perspective" aria-hidden="true">
      <div
        data-tilt="8"
        data-base-x="14"
        data-base-y="-20"
        class="preserve-3d relative mx-auto w-full max-w-[460px] py-10 space-y-6"
      >
        {layers.map((l, i) => (
          <div class="preserve-3d" style={`transform: translateZ(${l.z}px)`}>
            <div
              data-float
              class:list={[
                "glass spotlight p-5 flex items-center gap-4",
                l.accent && "!border-[var(--color-primary)]/50",
              ]}
              style={l.accent ? "box-shadow: 0 0 60px -10px var(--accent-glow), var(--glass-shadow), inset 0 1px 0 var(--glass-highlight)" : undefined}
            >
              <span class="icon-chip shrink-0"><i class={`bi ${l.icon}`}></i></span>
              <div class="min-w-0">
                <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[var(--text-muted)]">{l.label}</div>
                <div class="font-[family-name:var(--font-mono)] text-sm font-bold text-[var(--text-code)] truncate">{l.pkg}</div>
                {l.detail && <div class="text-xs text-[var(--text-muted)] mt-0.5">{l.detail}</div>}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
