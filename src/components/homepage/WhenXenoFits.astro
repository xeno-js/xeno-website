---
const packages = [
  { name: '@xeno-js/core', icon: 'bi-cpu', description: 'Dependency injection, CQRS, pipelines and the Node.js application runtime.', docs: '/docs/introduction', github: 'https://github.com/xeno-js/core' },
  { name: '@xeno-js/shared', icon: 'bi-diamond', description: 'Domain primitives, contracts, aggregates and Result types.', docs: '/docs/introduction/architecture-overview', github: 'https://github.com/xeno-js/shared' },
  { name: '@xeno-js/cli', icon: 'bi-terminal', description: 'Scaffold projects and generate application components.', docs: '/docs/cli/overview', github: 'https://github.com/xeno-js/xeno-cli' },
  { name: '@xeno-js/vue', icon: 'bi-window', description: 'Use application composition, commands and queries in Vue.', docs: '/docs/vue/plugin-vue', github: 'https://github.com/xeno-js/vue' },
];
---

<!-- Carousel with pagination -->
<section id="packages" data-pin class="hx-pin px-6">
  <div class="hx-pin-sticky mx-auto max-w-[var(--container-max)]">
    <div data-reveal class="max-w-3xl">
      <p class="hx-eyebrow mb-3">05 / Ecosystem</p>
      <h2 class="hx-title">Choose the pieces you need.</h2>
      <p class="hx-lead mt-5">Start with the core and add integrations for your transport, database and tooling.</p>
    </div>
    <div data-carousel class="mt-8">
      <div data-carousel-rail tabindex="0" role="region" aria-roledescription="carousel" aria-label="Xeno.JS packages" class="hx-rail -mx-6 px-6 [perspective:1200px] sm:mx-0 sm:px-0">
        {packages.map((pkg, index) => (
          <div data-carousel-slide data-active={index === 0 ? 'true' : 'false'} class="hx-slide" role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${packages.length}`}>
            <article class="hx-glass hx-tilt flex min-h-64 flex-col p-7">
              <span class="hx-pop flex h-12 w-12 items-center justify-center rounded-xl border border-[var(--glass-border)] bg-[var(--accent-glow)] text-xl text-[var(--color-primary)]"><i class={`bi ${pkg.icon}`} aria-hidden="true"></i></span>
              <h3 class="hx-pop mt-6 font-[family-name:var(--font-mono)] text-base font-semibold text-[var(--color-primary)]">{pkg.name}</h3>
              <p class="mt-3 flex-1 text-[var(--text-muted)]">{pkg.description}</p>
              <div class="mt-5 flex gap-6 text-sm font-semibold"><a href={pkg.docs} class="inline-flex min-h-11 items-center text-[var(--text-main)] hover:text-[var(--color-primary)]">Documentation<span class="sr-only"> for {pkg.name}</span></a><a href={pkg.github} class="inline-flex min-h-11 items-center text-[var(--text-muted)] hover:text-[var(--color-primary)]">GitHub<span class="sr-only"> for {pkg.name}</span></a></div>
            </article>
          </div>
        ))}
      </div>
      <div data-carousel-controls hidden class="flex items-center justify-center gap-3">
        <button type="button" data-carousel-prev aria-label="Previous package" class="hx-arrow"><i class="bi bi-arrow-left" aria-hidden="true"></i></button>
        <div class="flex items-center">
          {packages.map((pkg, index) => (
            <button type="button" data-carousel-dot={index} aria-label={`Go to ${pkg.name}`} aria-current={index === 0 ? 'true' : 'false'} class="hx-dot-hit"><span class="hx-dot" aria-current={index === 0 ? 'true' : 'false'}></span></button>
          ))}
        </div>
        <button type="button" data-carousel-next aria-label="Next package" class="hx-arrow"><i class="bi bi-arrow-right" aria-hidden="true"></i></button>
      </div>
      <div class="hx-progress mx-auto mt-4 max-w-xs" aria-hidden="true"><span data-pin-bar></span></div>
    </div>
  </div>
</section>