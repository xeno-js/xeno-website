---
const code = `import { XenoAppBuilder } from '@xeno-js/core'
import type { XenoRegistry } from '@xeno-js/core'
import { withPostgresql } from '@xeno-js/postgresql'
import type { DbContext, DbTransaction } from '@xeno-js/postgresql'

class OrderService {}
interface AppRegistry extends XenoRegistry<DbContext, DbTransaction> {
  ORDER_SERVICE: OrderService
}

const builder = new XenoAppBuilder<AppRegistry>()
  .addLogger()
  .addDb(withPostgresql<AppRegistry>((options, config) => {
    options.connectionString = config.getOrThrow('DATABASE_URL')
  }))
  .addPipeline()
  .addServices((services) => {
    services.addScoped('ORDER_SERVICE', () => new OrderService())
  })

const app = await builder.build()`;

const trace = [
  { n: '01', label: 'Request context', icon: 'bi-broadcast', text: 'With middleware configured, request context and identity are available to downstream work through AsyncLocalStorage.' },
  { n: '02', label: 'Mediator and validation', icon: 'bi-funnel', text: 'A controller can send a command through the mediator. A configured Zod pipeline validates it before the handler runs.' },
  { n: '03', label: 'Result and response', icon: 'bi-check2-circle', text: 'The handler returns a Result. The controller maps the outcome to an HTTP response, such as 201 Created.' },
];
---

<!-- Code and request flow -->
<section id="code" class="px-6 py-20 sm:py-28">
  <div class="mx-auto grid max-w-[var(--container-max)] items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
    <div>
      <div data-reveal>
        <p class="hx-eyebrow mb-3">04 / Composition and execution</p>
        <h2 class="hx-title">See what your application runs.</h2>
        <p class="hx-lead mt-5">Compose services, logging, a database and the CQRS pipeline in code. The example uses the PostgreSQL integration and a configured <code>DATABASE_URL</code>.</p>
      </div>
      <ul class="m-0 mt-8 list-none space-y-5 p-0">
        {trace.map((step) => (
          <li data-reveal class="flex gap-4">
            <span class="mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[var(--color-primary)] bg-[var(--accent-glow)] text-[var(--color-primary)]"><i class={`bi ${step.icon}`} aria-hidden="true"></i></span>
            <div>
              <h3 class="font-[family-name:var(--font-mono)] text-sm font-semibold text-[var(--text-main)]">{step.n} / {step.label}</h3>
              <p class="mt-1 text-sm text-[var(--text-muted)]">{step.text}</p>
            </div>
          </li>
        ))}
      </ul>
      <p data-reveal class="mt-6 text-xs text-[var(--text-muted)]">Illustrative flow. Middleware, validation and response status depend on your configuration.</p>
    </div>
    <div data-reveal class="min-w-0 [perspective:1400px]">
      <div class="md:overflow-visible overflow-y-hidden hx-glass hx-tilt min-w-0 !bg-[var(--bg-primary)]/80">
        <div class="hx-pop flex items-center justify-between border-b border-[var(--glass-border)] px-6 py-4 font-[family-name:var(--font-mono)] text-xs text-[var(--text-muted)]"><span>src/bootstrap.ts</span><span>TypeScript</span></div>
        <pre class="hx-pop-lg m-0 p-6 text-xs leading-6 text-[var(--text-main)] sm:text-sm" tabindex="0"><code>{code}</code></pre>
      </div>
    </div>
  </div>
</section>
