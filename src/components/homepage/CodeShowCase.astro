---
const codeSnippet = `import { XenoAppBuilder, LOG_LEVEL, TOKENS } from '@xeno-js/core'

export const XenoApp = new XenoAppBuilder<MyRegistry>()
   .addLogger([
      withConsoleLogger((opts, config) => {
        opts.isEnabled = config.getEnvironment() === 'development'
        opts.level = LOG_LEVEL.DEBUG
      })
    ])
    .addDb(withPostgresql((opts, config) => {
      opts.connectionString = config.getOrThrow('DATABASE_URL')
    }))
   .addServices((srv) => {
        srv.addTransient('MY_SERVICE', (c) => new MyService(c.resolve(TOKENS.LOGGER)))
   })

await XenoApp.build()`;

const checks = [
  "Explicit registrations",
  "Singleton-to-scoped dependency checks",
  "Compile-time contracts",
  "Framework-independent domain",
];
---

<section class="py-24 px-6 relative overflow-hidden">
  <div class="absolute top-1/2 right-0 w-[520px] h-[520px] rounded-full bg-[var(--color-primary)] opacity-[0.08] blur-[130px] pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 max-w-[var(--container-max)] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-14 items-center">
    <div data-reveal class="lg:col-span-5">
      <span class="eyebrow mb-5"><i class="bi bi-code-slash"></i> Dependency injection</span>
      <h2 class="section-title !mt-5">
        Register dependencies <span class="text-[var(--color-primary)]">in code</span>.
      </h2>
      <p class="section-lead mb-8">
        Register services with explicit lifetimes and typed contracts, without decorator metadata. During singleton construction, the container rejects scoped dependencies, including those reached through transient services.
      </p>
      <ul class="list-none p-0 m-0 space-y-3 font-medium">
        {checks.map((c) => (
          <li class="flex items-center gap-3">
            <i class="bi bi-check2-circle text-[var(--color-primary)] text-lg"></i>{c}
          </li>
        ))}
      </ul>
    </div>

    <div data-reveal data-reveal-delay="0.15" class="lg:col-span-7 perspective">
      <div data-tilt="3" data-base-x="2" data-base-y="-4" class="glass overflow-hidden">
        <div class="flex items-center justify-between px-5 py-3.5 border-b border-[var(--glass-border)]">
          <div class="flex gap-2" aria-hidden="true">
            <span class="w-3 h-3 rounded-full bg-[var(--border-color-hover)]"></span>
            <span class="w-3 h-3 rounded-full bg-[var(--border-color-hover)]"></span>
            <span class="w-3 h-3 rounded-full bg-[var(--border-color-hover)]"></span>
          </div>
          <span class="flex items-center gap-2 text-xs font-mono text-[var(--text-muted)]">
            <i class="bi bi-file-earmark-code text-[var(--color-primary)]"></i> src/main.ts
          </span>
          <span class="w-10"></span>
        </div>
        <pre class="m-0 p-6 overflow-x-auto font-[family-name:var(--font-mono)] text-xs sm:text-sm leading-relaxed text-[var(--text-main)]"><code>{codeSnippet}</code></pre>
        <div class="px-5 py-2.5 border-t border-[var(--glass-border)] flex items-center justify-between text-[11px] font-mono text-[var(--text-muted)]">
          <span class="flex items-center gap-1.5 text-[var(--color-primary)]"><i class="bi bi-check-circle-fill"></i> TypeScript strict</span>
          <span>UTF-8</span>
        </div>
      </div>
    </div>
  </div>
</section>
