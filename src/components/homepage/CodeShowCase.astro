---
import Button from '../ui/Button.astro';

// TypeScript code snippet to highlight Xeno's fluent API
const codeSnippet = `import { AppBuilder, LOG_LEVEL, TOKENS } from '@xeno-js/core'

export const XenoApp = new AppBuilder<MyRegistry>()
   .addLogger((config) => {
            config.level = LOG_LEVEL.INFO
            config.console = true
    })
   .addDb((opts, config) => {
            opts.connectionString = config.getOrThrow('DATABASE_URL')
    })
   .addServices((srv) => {
        srv.addTransient('MY_SERVICE', (c) => new MyService(c.resolve(TOKENS.LOGGER)))
   })

await XenoApp.build()`;
---

<section class="py-24 relative overflow-hidden bg-[var(--bg-secondary)]" >
  
  {/* Sfumatura verde fluo diffusa */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[var(--color-primary)] opacity-10 blur-[120px] rounded-full pointer-events-none -z-10"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-primary)]/5 via-transparent to-transparent pointer-events-none -z-10"></div>

  <div class="max-w-[var(--container-max)] mx-auto px-6 relative z-10">
    
    {/* Responsive Grid: Column on mobile, Two columns from tablet (md) */}
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
      
      {/* Left Column: Title, Paragraph, Button */}
      <div data-aos="fade-right" data-aos-delay="100" class="md:col-span-5 text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-xs font-semibold mb-4 tracking-wider uppercase border border-[var(--color-primary)]/20">
          <i class="bi bi-code-slash"></i> Fluent Architecture
        </div>
        
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[var(--text-main)] mb-6 leading-[1.15]">
          Dependencies you can see, reason about, and <span class="text-[var(--color-primary)]">trust</span>.
        </h2>
        
        <p class="text-[length:var(--body-size)] text-[var(--text-muted)] leading-relaxed mb-8">
          Xeno uses an explicit functional container with deterministic lifetimes. It catches captive dependencies before they become production memory leaks and preserves compile-time safety without decorator metadata.
        </p>
        
        <div class="mx-4">
          <ul class="flex flex-col gap-3 text-sm text-[var(--text-main)] font-medium">
            <li data-aos="fade-up" data-aos-delay="200" class="flex items-center gap-2.5">
              <i class="bi bi-check-circle-fill text-[var(--color-primary)]"></i>
              <span>Explicit registrations</span>
            </li>
            <li data-aos="fade-up" data-aos-delay="250" class="flex items-center gap-2.5">
              <i class="bi bi-check-circle-fill text-[var(--color-primary)]"></i>
              <span>Lifetime safety</span>
            </li>
            <li data-aos="fade-up" data-aos-delay="300" class="flex items-center gap-2.5">
              <i class="bi bi-check-circle-fill text-[var(--color-primary)]"></i>
              <span>Compile-time contracts</span>
            </li>
            <li data-aos="fade-up" data-aos-delay="350" class="flex items-center gap-2.5">
              <i class="bi bi-check-circle-fill text-[var(--color-primary)]"></i>
              <span>Framework-independent domain</span>
            </li>
          </ul>
        </div>
      </div>

      {/* Right Column: PC Screen Mockup with Code Snippet */}
      <div data-aos="fade-left" data-aos-delay="180" class="md:col-span-7">
        <div class="rounded-[var(--border-radius)] bg-[var(--bg-secondary)]/70 border border-[var(--border-color)] backdrop-blur-2xl shadow-2xl overflow-hidden group">
          
          {/* PC Window / Editor Header bar */}
          <div class="flex items-center justify-between px-5 py-3.5 bg-[var(--bg-secondary)] border-b border-[var(--border-color)]">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
            </div>
            <div class="flex items-center gap-2 text-xs font-mono text-[var(--text-muted)]">
              <i class="bi bi-file-earmark-code text-[var(--color-primary)]"></i>
              <span>src/main.ts</span>
            </div>
            <div class="w-10"></div> {/* Spacer for symmetry */}
          </div>

          {/* Code Content Box */}
          <div class="p-6 overflow-x-auto bg-[#070707]/90">
            <pre class="font-[family-name:var(--font-mono)] text-xs sm:text-sm text-[var(--text-main)] leading-relaxed"><code>{codeSnippet}</code></pre>
          </div>

          {/* Editor Footer Status Bar */}
          <div class="px-5 py-2.5 bg-[var(--bg-secondary)]/50 border-t border-[var(--border-color)] flex items-center justify-between text-[11px] font-mono text-[var(--text-muted)]">
            <span class="flex items-center gap-1.5 text-[var(--color-primary)]">
              <i class="bi bi-check-circle-fill"></i> TypeScript 5.x Strict
            </span>
            <span>UTF-8</span>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>