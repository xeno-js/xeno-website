---
const problems = [
  { icon: 'bi-signpost-split', label: 'Routes', title: 'Business logic in HTTP routes', text: 'Move use cases into commands, queries and handlers. Keep transport-specific code at the edge.' },
  { icon: 'bi-diagram-3', label: 'Dependencies', title: 'Dependencies are hard to follow', text: 'Register services and their lifetimes explicitly in the application builder, without decorator metadata.' },
  { icon: 'bi-shield-check', label: 'Validation', title: 'Validation repeated in handlers', text: 'Add a validation pipeline once and register a Zod schema for each request intent.' },
  { icon: 'bi-bug', label: 'Errors', title: 'Errors mixed into business logic', text: 'Use Result values and exception handling to carry outcomes back to the controller.' },
];

---
<!-- Sticky scroll storytelling -->
<section id="architecture" class="px-6 py-16 sm:py-24">
  <div class="mx-auto grid max-w-[var(--container-max)] gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <div data-reveal>
        <p class="hx-eyebrow mb-3">02 / Backend architecture</p>
        <h2 class="hx-title">Give growing backend code room to change.</h2>
        <p class="hx-lead mt-5">As a product grows, Xeno.JS helps teams separate application behavior from HTTP and infrastructure.</p>
        <div class="hx-glass mt-8 hidden p-6 lg:block" aria-hidden="true">
          <div class="font-[family-name:var(--font-mono)] text-6xl font-extrabold text-[var(--color-primary)]"><span data-step-current>01</span><span class="text-2xl text-[var(--text-muted)]"> / 04</span></div>
          <div data-step-label class="mt-2 text-sm text-[var(--text-muted)]">Business logic in HTTP routes</div>
          <div class="hx-progress mt-5"><span data-step-bar></span></div>
        </div>
        <a href="/docs/getting_started/installation" class="hx-link mt-6">Start building with Xeno.JS <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
      </div>
    </div>
    <div class="space-y-6 lg:space-y-[14vh] lg:pb-[10vh]">
      {problems.map((item, index) => (
        <article data-step data-step-title={item.title} data-active={index === 0 ? 'true' : 'false'} class="hx-step hx-glass hx-tilt p-7 sm:p-9">
          <div class="flex items-center gap-4">
            <span class="hx-pop flex h-14 w-14 items-center justify-center rounded-2xl border border-[var(--glass-border)] bg-[var(--accent-glow)] text-2xl text-[var(--color-primary)]"><i class={`bi ${item.icon}`} aria-hidden="true"></i></span>
            <span class="font-[family-name:var(--font-mono)] text-xs uppercase text-[var(--color-primary)]">0{index + 1} / {item.label}</span>
          </div>
          <h3 class="hx-pop mt-6 text-2xl font-bold sm:text-3xl">{item.title}</h3>
          <p class="mt-3 max-w-lg text-[var(--text-muted)]">{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>