---
const points = [
  {
    id: "ioc",
    icon: "bi-box-seam",
    title: "Explicit dependency injection",
    text: "Register dependencies in code without decorators or directory scanning. The registrations show how the application is composed.",
  },
  {
    id: "cqrs",
    icon: "bi-arrow-left-right",
    title: "Commands, queries and pipelines",
    text: "Use commands and queries for application operations. Pipelines run validation, logging, caching and resilience around handlers.",
  },
  {
    id: "model",
    icon: "bi-layers",
    title: "Application patterns for Node.js and Vue",
    text: "Use domain primitives, contracts, commands, queries, pipelines and explicit context across backend and Vue applications.",
  },
];
---

<section class="py-24 px-6">
  <div class="max-w-[var(--container-max)] mx-auto">
    <div data-reveal class="max-w-3xl mb-14">
      <span class="eyebrow mb-5"><i class="bi bi-gem"></i> The core idea</span>
      <h2 class="section-title !mt-5">
        What Xeno.<span class="text-[var(--color-primary)]">JS</span> provides
      </h2>
      <p class="section-lead">
        Xeno.JS provides dependency injection, CQRS, pipelines and request context for TypeScript applications. These building blocks help separate business logic from HTTP, databases and UI concerns while working with your existing stack.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {points.map((p, i) => (
        <div class="perspective" data-reveal data-reveal-delay={i * 0.1}>
          <article data-tilt="6" data-concept={p.id} class="pillar-card glass spotlight h-full p-8">
            <span class="icon-chip mb-6">
              <i class={`bi ${p.icon}`}></i>
            </span>
            <h3 class="!text-[var(--text-main)] !mt-0 !mb-3">{p.title}</h3>
            <p class="!text-[var(--text-muted)] !m-0">{p.text}</p>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pillar-card {
    transition: border-color 200ms ease;
  }

  .pillar-card .icon-chip {
    transition:
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 200ms ease,
      background-color 200ms ease;
  }

  .pillar-card .icon-chip i {
    display: inline-block;
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* 1. Zero-Magic IoC: leggera rotazione del chip come attivazione esplicita */
  .pillar-card[data-concept="ioc"]:hover .icon-chip,
  .pillar-card[data-concept="ioc"]:focus-within .icon-chip {
    transform: translateY(-2px) rotate(-3deg);
    border-color: color-mix(in srgb, var(--color-primary) 45%, transparent);
  }

  /* 2. Native CQRS & Pipeline: micro-shift orizzontale sull'icona delle frecce */
  .pillar-card[data-concept="cqrs"]:hover .icon-chip,
  .pillar-card[data-concept="cqrs"]:focus-within .icon-chip {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-primary) 45%, transparent);
  }

  .pillar-card[data-concept="cqrs"]:hover .icon-chip i,
  .pillar-card[data-concept="cqrs"]:focus-within .icon-chip i {
    transform: translateX(2px);
  }

  /* 3. One Application Model: leggera espansione verticale del chip */
  .pillar-card[data-concept="model"]:hover .icon-chip,
  .pillar-card[data-concept="model"]:focus-within .icon-chip {
    transform: translateY(-3px) scale(1.04);
    border-color: color-mix(in srgb, var(--color-primary) 45%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .pillar-card,
    .pillar-card .icon-chip,
    .pillar-card .icon-chip i {
      transition: none;
    }

    .pillar-card:hover .icon-chip,
    .pillar-card:focus-within .icon-chip,
    .pillar-card:hover .icon-chip i,
    .pillar-card:focus-within .icon-chip i {
      transform: none;
    }
  }
</style>