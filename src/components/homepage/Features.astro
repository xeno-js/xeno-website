---
import Button from "../ui/Button.astro";

const packages = [
  {
    name: "@xeno-js/core",
    description: "Build Node.js applications with dependency injection, scopes, request context, CQRS, pipelines, modules, transactions and repositories.",
    icon: "bi-cpu",
    docsUrl: "/docs/introduction",
    githubUrl: "https://github.com/xeno-js/core",
  },
  {
    name: "@xeno-js/vue",
    description: "Use explicit application composition, commands, queries, pipelines, context, validation and data sources in Vue.",
    icon: "bi-browser-edge",
    docsUrl: "/docs/vue/plugin-vue",
    githubUrl: "https://github.com/xeno-js/vue",
  },
  {
    name: "@xeno-js/shared",
    description: "Define domain logic with value objects, aggregates, domain events, Result types, errors and application contracts.",
    icon: "bi-layers-half",
    docsUrl: "/docs/introduction/architecture-overview",
    githubUrl: "https://github.com/xeno-js/shared",
  },
  {
    name: "@xeno-js/cli",
    description: "Scaffold projects and generate application components instead of rebuilding the same structure by hand.",
    icon: "bi-terminal",
    docsUrl: "/docs/cli/overview",
    githubUrl: "https://github.com/xeno-js/xeno-cli",
    delay: 300,
  },
];
---

<section class="py-24 px-6 relative" id="packages">
  <div class="max-w-[var(--container-max)] mx-auto">
    <div data-reveal class="max-w-2xl mb-14">
      <span class="eyebrow mb-5"><i class="bi bi-boxes"></i> The ecosystem</span>
      <h2 class="section-title !mt-5">
        Packages for your <span class="text-[var(--color-primary)]">application stack.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {packages.map((pkg, i) => (
        <div class="perspective" data-reveal data-reveal-delay={(i % 2) * 0.1}>
          <article data-tilt="4" class="glass spotlight h-full p-8 flex flex-col min-h-[240px]">
            <span class="icon-chip mb-8"><i class={`bi ${pkg.icon}`}></i></span>
            <h3 class="font-[family-name:var(--font-mono)] !text-[var(--text-code)] !text-lg !mt-0 !mb-2">{pkg.name}</h3>
            <p class="!text-[var(--text-muted)] text-sm leading-relaxed flex-grow">{pkg.description}</p>
            <div class="flex items-center gap-3 mt-2">
              <Button href={pkg.docsUrl} variant="primary" class="!px-4 !py-2 !text-sm">
                <i class="bi bi-book"></i> Docs<span class="sr-only"> for {pkg.name}</span>
              </Button>
              <Button href={pkg.githubUrl} variant="secondary" class="!px-4 !py-2 !text-sm" target="_blank">
                <i class="bi bi-github"></i> GitHub<span class="sr-only"> repository for {pkg.name}</span>
              </Button>
            </div>
          </article>
        </div>
      ))}
    </div>

    <div class="mt-8 text-center">
      <Button href="https://github.com/orgs/xeno-js/repositories" variant="primary" class="!px-4 !py-2 !text-sm" target="_blank">
        Explore all repositories
      </Button>
    </div>
  </div>
</section>
