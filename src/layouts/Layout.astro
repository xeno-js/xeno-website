---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';

import 'bootstrap-icons/font/bootstrap-icons.css';

interface FAQItem {
  question: string;
  answer: string;
}

interface ArticleMeta {
  pubDate: Date;
  author?: string;
}

interface Props {
  title: string;
  description: string;
  image?: {
    src: string;
    alt: string;
  } | null;
  canonicalURL?: string;
  type?: 'website' | 'article' | 'faq';
  keywords?: string[];
  faqs?: FAQItem[];
  articleMeta?: ArticleMeta;
}

const {
  title,
  description,
  image = { src: '/img/logo.png', alt: 'Xeno.JS Logo' },
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  type = 'website',
  keywords = ['TypeScript', 'Application Framework', 'Node.js', 'Domain-Driven Design', 'CQRS', 'Dependency Injection', 'Backend'],
  faqs = [],
  articleMeta
} = Astro.props;

const siteURL = new URL('/', Astro.site).href;
const websiteId = `${siteURL}#website`;
const organizationId = `${siteURL}#organization`;
const applicationId = `${siteURL}#application`;

// Costruzione dinamica del grafo JSON-LD in base al tipo di pagina
const graphNodes: any[] = [
  {
    "@type": "WebSite",
    "@id": websiteId,
    "url": siteURL,
    "name": "Xeno.JS",
    "description": "A TypeScript backend framework for Node.js applications.",
    "inLanguage": "en",
    "publisher": {
      "@id": organizationId
    }
  },
  {
    "@type": "Organization",
    "@id": organizationId,
    "name": "Xeno.JS",
    "url": siteURL,
    "logo": {
      "@type": "ImageObject",
      "url": new URL('/img/logo.png', Astro.site).href
    },
    "sameAs": [
      "https://github.com/xeno-js/xeno-js"
    ]
  }
];

// Se è la Homepage o una pagina applicativa generale
if (type === 'website' && Astro.url.pathname === '/') {
  graphNodes.push(
    {
      "@type": "SoftwareApplication",
      "@id": applicationId,
      "name": "Xeno.JS",
      "applicationCategory": "DeveloperApplication",
      "runtimePlatform": "Node.js",
      "description": description,
      "url": canonicalURL,
      "keywords": keywords,
      "author": {
        "@id": organizationId
      }
    },
    {
      "@type": "SoftwareSourceCode",
      "name": "Xeno.JS Source Code",
      "programmingLanguage": "TypeScript",
      "codeRepository": "https://github.com/xeno-js/xeno-js",
      "license": "https://opensource.org/licenses/MIT",
      "targetProduct": {
        "@id": applicationId
      }
    }
  );
}

// Se è un articolo del blog
if (type === 'article' && articleMeta) {
  graphNodes.push({
    "@type": "TechArticle",
    "headline": title,
    "description": description,
    "url": canonicalURL,
    "datePublished": articleMeta.pubDate.toISOString(),
    "inLanguage": "en",
    "author": {
      "@type": "Organization",
      "name": articleMeta.author || "Xeno.JS"
    },
    "publisher": {
      "@id": organizationId
    },
    "keywords": keywords
  });
}

// Se sono presenti FAQ nella pagina
if (faqs.length > 0) {
  graphNodes.push({
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  });
}

const structuredData = {
  "@context": "https://schema.org",
  "@graph": graphNodes
};

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      const savedTheme = localStorage.getItem('starlight-theme');
      document.documentElement.dataset.theme = savedTheme === 'light' || savedTheme === 'dark'
        ? savedTheme
        : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={canonicalURL} />

    {/* JSON-LD Dinamico */}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image.src, Astro.site).href} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image.src, Astro.site).href} />

    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
  </head>
  <body class="bg-[var(--bg-primary)] text-[var(--text-main)] min-h-screen flex flex-col font-[family-name:var(--font-sans)] antialiased selection:bg-[var(--color-primary)] selection:text-[var(--bg-primary)]">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-[var(--bg-secondary)] focus:px-4 focus:py-2 focus:text-[var(--text-main)]">Skip to content</a>
    {/* Global Top Navbar */}
    <Navbar currentPath={currentPath} />

    {/* Main Semantic Content Wrapper */}
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    {/* Global Footer */}
    <Footer />

  </body>
</html>